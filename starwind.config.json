{
  "$schema": "https://starwind.dev/config-schema.json",
  "tailwind": {
    "css": "src/styles/starwind.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "componentDir": "src/components",
  "utilsDir": "src/lib/utils",
  "components": [
    {
      "name": "button",
      "version": "2.3.2"
    },
    {
      "name": "card",
      "version": "2.0.1"
    },
    {
      "name": "carousel",
      "version": "1.0.3"
    },
    {
      "name": "collapsible",
      "version": "1.0.1"
    },
    {
      "name": "dropdown",
      "version": "1.3.1"
    },
    {
      "name": "separator",
      "version": "1.0.1"
    },
    {
      "name": "image",
      "version": "1.0.1"
    },
    {
      "name": "aspect-ratio",
      "version": "1.0.2"
    },
    {
      "name": "avatar",
      "version": "1.2.2"
    },
    {
      "name": "input",
      "version": "1.3.2"
    },
    {
      "name": "label",
      "version": "1.2.1"
    },
    {
      "name": "select",
      "version": "1.8.4"
    },
    {
      "name": "textarea",
      "version": "1.3.2"
    },
    {
      "name": "badge",
      "version": "1.4.2"
    },
    {
      "name": "progress",
      "version": "1.1.2"
    }
  ],
  "registries": {
    "@starwind-pro": {
      "url": "https://pro.starwind.dev/r/{name}",
      "headers": {
        "Authorization": "Bearer ${STARWIND_LICENSE_KEY}"
      }
    }
  }
}
