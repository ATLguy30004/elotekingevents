    <!-- ===== JAVASCRIPT ===== -->
    <script>
      // --- Force ALL video autoplay (mobile + desktop) ---
      (function() {
        var vids = document.querySelectorAll('video[autoplay]');
        if (!vids.length) return;
        function tryPlay(v) { v.muted = true; v.play().catch(function(){}); }
        vids.forEach(tryPlay);
        vids.forEach(function(v) {
          v.addEventListener('loadeddata', function() { tryPlay(v); }, { once: true });
          v.addEventListener('canplay', function() { tryPlay(v); }, { once: true });
        });
        function onInteract() {
          vids.forEach(tryPlay);
          document.removeEventListener('touchstart', onInteract);
          document.removeEventListener('click', onInteract);
          document.removeEventListener('scroll', onInteract);
        }
        document.addEventListener('touchstart', onInteract, { passive: true });
        document.addEventListener('click', onInteract, { passive: true });
        document.addEventListener('scroll', onInteract, { passive: true });
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) { if (e.isIntersecting) tryPlay(e.target); });
        }, { threshold: 0.1 });
        vids.forEach(function(v) { obs.observe(v); });
        var retries = 0;
        var ri = setInterval(function() {
          retries++;
          vids.forEach(function(v) { if (v.paused && v.readyState >= 2) tryPlay(v); });
          if (retries >= 20) clearInterval(ri);
        }, 500);
      })();

      // --- Nav scroll effect ---
      const navbar = document.getElementById('navbar');
      window.addEventListener('scroll', () => {
        navbar.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      // --- Mobile drawer ---
      const hamburger = document.getElementById('hamburger');
      const drawer = document.getElementById('mobile-drawer');
      const drawerClose = document.getElementById('drawer-close');
      const drawerLinks = drawer.querySelectorAll('a');

      hamburger.addEventListener('click', () => {
        drawer.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });
      drawerClose.addEventListener('click', closeDrawer);
      drawerLinks.forEach(link => link.addEventListener('click', closeDrawer));

      function closeDrawer() {
        drawer.style.display = 'none';
        document.body.style.overflow = '';
      }

      // --- Intersection Observer for fade animations ---
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      document.querySelectorAll('.fade-up, .fade-in').forEach(el => observer.observe(el));

      // --- Countdown timer (synced across all locations) ---
      const eventDate = new Date('2026-03-28T19:00:00-04:00').getTime();
      const cdDays = document.getElementById('cd-days');
      const cdHours = document.getElementById('cd-hours');
      const cdMins = document.getElementById('cd-mins');
      const cdSecs = document.getElementById('cd-secs');

      // Ticker countdown elements
      const tickerCd = document.getElementById('ticker-cd');
      const tickerCd2 = document.getElementById('ticker-cd-2');
      const stickyCountdown = document.getElementById('sticky-countdown');

      // Navbar countdown elements
      const navD = document.getElementById('nav-cd-d');
      const navH = document.getElementById('nav-cd-h');
      const navM = document.getElementById('nav-cd-m');
      const navS = document.getElementById('nav-cd-s');

      function updateCountdown() {
        const now = Date.now();
        const diff = eventDate - now;

        if (diff <= 0) {
          cdDays.textContent = '0';
          cdHours.textContent = '0';
          cdMins.textContent = '0';
          cdSecs.textContent = '0';
          if (tickerCd) tickerCd.textContent = 'NOW';
          if (tickerCd2) tickerCd2.textContent = 'NOW';
          if (navD) navD.textContent = '0';
          if (navH) navH.textContent = '00';
          if (navM) navM.textContent = '00';
          if (navS) navS.textContent = '00';
          if (stickyCountdown) stickyCountdown.textContent = 'HAPPENING NOW';
          return;
        }

        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);

        // Main countdown (closer section)
        cdDays.textContent = d;
        cdHours.textContent = h;
        cdMins.textContent = m;

        // Pulse animation on seconds
        if (cdSecs.textContent !== String(s)) {
          cdSecs.style.animation = 'countPulse 0.1s ease';
          setTimeout(() => { cdSecs.style.animation = ''; }, 100);
        }
        cdSecs.textContent = s;

        // Ticker countdown
        const tickerStr = d > 0
          ? `${d}d ${String(h).padStart(2,'0')}h`
          : `${h}h ${String(m).padStart(2,'0')}m`;
        if (tickerCd) tickerCd.textContent = tickerStr;
        if (tickerCd2) tickerCd2.textContent = tickerStr;

        // Navbar countdown
        if (navD) navD.textContent = d;
        if (navH) navH.textContent = String(h).padStart(2, '0');
        if (navM) navM.textContent = String(m).padStart(2, '0');
        if (navS) navS.textContent = String(s).padStart(2, '0');

        // Sticky bar compact countdown
        if (stickyCountdown) {
          stickyCountdown.textContent = d > 0
            ? `${d}d ${h}h ${m}m`
            : `${h}h ${m}m ${s}s`;
        }
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);

      // --- Free ride counter (deterministic based on time, not random) ---
      // Creates believable progression: starts at 27 claimed out of 30, increases as event approaches
      // Same number for every visitor at the same time (no refresh abuse)
      function getRiderSpots() {
        const totalFreeRides = 30;
        const now = Date.now();
        const eventTime = eventDate;
        const launchTime = new Date('2026-03-25T12:00:00-04:00').getTime(); // page went live
        const elapsed = now - launchTime;
        const totalWindow = eventTime - launchTime;

        if (elapsed <= 0) return { claimed: 27, left: 3 };
        if (elapsed >= totalWindow) return { claimed: 30, left: 0 };

        // S-curve: slow start, fast middle, slow at end
        const progress = elapsed / totalWindow;
        const sCurve = 1 / (1 + Math.exp(-10 * (progress - 0.5)));
        const claimed = Math.min(totalFreeRides, Math.max(27, Math.floor(27 + (totalFreeRides - 27) * sCurve)));
        return { claimed, left: totalFreeRides - claimed };
      }

      function updateSpotCounters() {
        const { claimed, left } = getRiderSpots();
        const pct = Math.round((claimed / 30) * 100);

        // Hero counter — "X FREE RIDES LEFT TONIGHT"
        const heroLeft = document.getElementById('hero-spots-left');
        const heroBar = document.getElementById('hero-progress-bar');
        if (heroLeft) heroLeft.textContent = left + ' FREE RIDE' + (left !== 1 ? 'S' : '') + ' LEFT TONIGHT';
        if (heroBar) heroBar.style.width = pct + '%';

        // Challenge section — FOMO bar
        const challengeLeft = document.getElementById('challenge-left');
        const challengeBar = document.getElementById('challenge-progress-bar');
        if (challengeLeft) challengeLeft.textContent = left + ' FREE RIDE' + (left !== 1 ? 'S' : '') + ' LEFT TONIGHT';
        if (challengeBar) challengeBar.style.width = pct + '%';

        // Closer section — "X FREE RIDES LEFT TONIGHT" + progress bar
        const closerLeft = document.getElementById('closer-left');
        const closerBar = document.getElementById('closer-progress-bar');
        if (closerLeft) closerLeft.textContent = left + ' FREE RIDE' + (left !== 1 ? 'S' : '') + ' LEFT TONIGHT';
        if (closerBar) closerBar.style.width = pct + '%';

        // Sticky bar — number + mini bar
        const stickySpots = document.getElementById('sticky-spots');
        if (stickySpots) stickySpots.textContent = left;
        const stickyBar = document.getElementById('sticky-progress-bar');
        if (stickyBar) stickyBar.style.width = pct + '%';

        // Color shift: orange → red as free rides run low
        if (left <= 5) {
          document.querySelectorAll('#hero-spots-left, #sticky-spots, #closer-left, #challenge-left').forEach(el => {
            el.style.color = '#EF4444';
          });
          document.querySelectorAll('.fomo-bar-fill').forEach(bar => {
            bar.style.background = 'linear-gradient(90deg, #EF4444, #DC2626)';
            bar.style.boxShadow = '0 0 12px rgba(239,68,68,0.5)';
          });
        }
      }

      updateSpotCounters();
      setInterval(updateSpotCounters, 30000); // Update every 30s

      // --- Menu carousel (native touch-scroll + drag) ---
      function initCarousel(containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;
        const inner = container.querySelector('[style*="display:flex"]') || container.firstElementChild;
        let isDown = false, startX, scrollLeft;

        container.addEventListener('mousedown', (e) => {
          isDown = true;
          container.style.cursor = 'grabbing';
          startX = e.pageX - container.offsetLeft;
          scrollLeft = container.scrollLeft;
        });
        container.addEventListener('mouseleave', () => { isDown = false; container.style.cursor = 'grab'; });
        container.addEventListener('mouseup', () => { isDown = false; container.style.cursor = 'grab'; });
        container.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - container.offsetLeft;
          container.scrollLeft = scrollLeft - (x - startX) * 1.5;
        });

        // Enable native horizontal scroll
        container.style.overflowX = 'auto';
        container.style.scrollSnapType = 'x mandatory';
        container.style.webkitOverflowScrolling = 'touch';
        container.style.scrollbarWidth = 'none';
        container.style.msOverflowStyle = 'none';
      }

      initCarousel('menu-carousel');
      initCarousel('polaroid-carousel');

      // --- Copy link button ---
      const copyBtn = document.getElementById('copy-link-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('https://elotekingatlanta.com/bull-ride-march28/');
            copyBtn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            setTimeout(() => {
              copyBtn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> Copy the Link';
            }, 2000);
          } catch(e) {
            // Fallback
            const input = document.createElement('input');
            input.value = 'https://elotekingatlanta.com/bull-ride-march28/';
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            copyBtn.textContent = 'Copied!';
          }
        });
      }

      // --- Registration form submission ---
      const bullForm = document.getElementById('bull-ride-form');
      const formWrapper = document.getElementById('registration-form-wrapper');
      const formSuccess = document.getElementById('form-success');

      if (bullForm) {
        bullForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = bullForm.querySelector('button[type="submit"]');
          submitBtn.textContent = 'SENDING...';
          submitBtn.disabled = true;

          try {
            const formData = new FormData(bullForm);
            const res = await fetch(bullForm.action, {
              method: 'POST',
              body: formData,
              headers: { 'Accept': 'application/json' }
            });

            if (res.ok) {
              bullForm.style.display = 'none';
              formWrapper.querySelector('h3').style.display = 'none';
              formWrapper.querySelector('p').style.display = 'none';
              formSuccess.style.display = 'block';
            } else {
              submitBtn.textContent = 'SOMETHING WENT WRONG — TRY AGAIN';
              submitBtn.disabled = false;
            }
          } catch (err) {
            submitBtn.textContent = 'SOMETHING WENT WRONG — TRY AGAIN';
            submitBtn.disabled = false;
          }
        });
      }
    </script>

    <Analytics />
    <SpeedInsights />
  </body>
