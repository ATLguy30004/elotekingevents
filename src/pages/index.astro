---
/**
 * Bull Ride Night — March 28, 2026
 * Standalone event landing page — no Layout.astro import
 * Dark cinematic theme: #0A0A0A bg, 7 sections, clean rebuild
 * Rebuilt 2026-03-25 from BUILD-BRIEF.md
 */
// Progress bar built inline — Starwind Progress uses Tailwind classes which don't compile on this vanilla CSS page
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />

    <!-- GOOGLE ANALYTICS 4 — gtag.js -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DXC4GZ5K68"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DXC4GZ5K68');
    </script>
    <!-- END GA4 -->

    <!-- MICROSOFT CLARITY — heatmaps + session recordings -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "vm135hc933");
    </script>
    <!-- END CLARITY -->

    <!-- SEO -->
    <title>Bull Ride Night — March 28 | Elote King Atlanta | First 30 Ride FREE</title>
    <meta name="description" content="Mechanical Bull Ride Night at Elote King Atlanta — March 28, 7PM-11PM. First 30 riders ride FREE, then $5. Hold 12 seconds for free esquite. 20 seconds for a free entree. 100% Zabiha Halal street food in Alpharetta, GA." />
    <link rel="canonical" href="https://elotekingatlanta.com/bull-ride-march28/" />

    <!-- Open Graph -->
    <meta property="og:title" content="Bull Ride Night — March 28 | Elote King Atlanta" />
    <meta property="og:description" content="First 30 ride FREE. $5 after. Hold 12 sec for free esquite. 20 sec for a free entree. March 28, 7PM-11PM. 100% Zabiha Halal street food in Alpharetta." />
    <meta property="og:image" content="https://elotekingatlanta.com/images/elote-king-logo-transparent.png" />
    <meta property="og:url" content="https://elotekingatlanta.com/bull-ride-march28/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elote King Atlanta" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bull Ride Night — March 28 | Elote King Atlanta" />
    <meta name="twitter:description" content="First 30 ride FREE. $5 after. Hold 12 sec for free esquite. 20 sec for a free entree. March 28, 7PM-11PM. 100% Zabiha Halal." />
    <meta name="twitter:image" content="https://elotekingatlanta.com/images/elote-king-logo-transparent.png" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Font preload -->
    <link rel="preload" href="/fonts/bebas-neue-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Hero video preload removed — preload as="video" can block autoplay on mobile -->

    <!-- Event Schema JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Bull Ride Night — Elote King Atlanta",
      "description": "Mechanical Bull Ride Night. First 30 riders ride FREE, then $5. Hold 12 seconds for free esquite. 20 seconds for a free entree. 100% Zabiha Halal Mexican street food in Alpharetta, GA.",
      "startDate": "2026-03-28T19:00:00-04:00",
      "endDate": "2026-03-28T23:00:00-04:00",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": "Elote King Atlanta",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "6180 Atlanta Hwy Suite A",
          "addressLocality": "Alpharetta",
          "addressRegion": "GA",
          "postalCode": "30004",
          "addressCountry": "US"
        }
      },
      "organizer": {
        "@type": "FoodEstablishment",
        "name": "Elote King Atlanta",
        "url": "https://elotekingatlanta.com",
        "telephone": "+1-678-208-8774"
      },
      "offers": [{
        "@type": "Offer",
        "name": "Free Ride (First 30)",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/LimitedAvailability",
        "validFrom": "2026-03-20",
        "url": "https://elotekingatlanta.com/bull-ride-march28/"
      }, {
        "@type": "Offer",
        "name": "Paid Ride (After First 30)",
        "price": "5",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-03-20",
        "url": "https://elotekingatlanta.com/bull-ride-march28/"
      }],
      "image": "https://elotekingatlanta.com/images/elote-king-logo-transparent.png",
      "isAccessibleForFree": true
    })} />

    <style is:global>
      /* ===== DESIGN SYSTEM — Bull Ride Night ===== */
      @font-face {
        font-family: 'Bebas Neue';
        src: url('/fonts/bebas-neue-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'DM Sans';
        src: url('/fonts/dm-sans-latin.woff2') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --page-bg: #0A0A0A;
        --surface: #171717;
        --text-primary: #FAFAFA;
        --text-body: rgba(250,250,250,0.85);
        --text-muted: rgba(250,250,250,0.6);
        --orange: #F97316;
        --orange-hover: #EA580C;
        --orange-glow: rgba(249,115,22,0.12);
        --gold: #EAB308;
        --gold-glow: rgba(234,179,8,0.08);
        --trust-green: #16a34a;
        --border-subtle: rgba(255,255,255,0.08);
        --border-visible: rgba(255,255,255,0.15);
        --font-heading: 'Bebas Neue', sans-serif;
        --font-body: 'DM Sans', sans-serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; }

      body {
        background: var(--page-bg);
        color: var(--text-primary);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-heading);
        font-weight: 400;
        text-transform: uppercase;
      }

      img, video { display: block; max-width: 100%; }

      a { color: inherit; text-decoration: none; }

      .section-padding {
        padding: 96px 24px;
      }
      .section-inner {
        max-width: 1200px;
        margin: 0 auto;
      }

      /* ===== ANIMATIONS ===== */
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes ticker {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.3); }
      }
      @keyframes countPulse {
        0% { transform: scale(0.92); }
        100% { transform: scale(1); }
      }

      .fade-up {
        opacity: 0;
        transform: translateY(24px);
      }
      .fade-up.visible {
        animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      .fade-in {
        opacity: 0;
      }
      .fade-in.visible {
        animation: fadeIn 0.4s ease forwards;
      }

      /* ===== BUTTON STYLES ===== */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--orange);
        color: var(--page-bg);
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 16px;
        letter-spacing: 0.5px;
        padding: 16px 32px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
        text-transform: uppercase;
      }
      .btn-primary:hover {
        background: var(--orange-hover);
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(249,115,22,0.35);
      }

      .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: var(--text-primary);
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 16px;
        letter-spacing: 0.5px;
        padding: 16px 32px;
        border-radius: 10px;
        border: 1.5px solid rgba(250,250,250,0.4);
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
      }
      .btn-ghost:hover {
        background: rgba(250,250,250,0.06);
        border-color: rgba(250,250,250,0.6);
      }

      /* ===== CARD STYLE ===== */
      .card {
        background: var(--surface);
        border-radius: 16px;
        border: 1px solid var(--border-subtle);
        box-shadow: 0 4px 24px rgba(0,0,0,0.4);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .card:hover {
        transform: scale(1.02);
        box-shadow: 0 8px 40px rgba(0,0,0,0.6);
      }

      /* Accessibility */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (max-width: 768px) {
        .section-padding {
          padding: 56px 20px;
        }
        .btn-primary, .btn-ghost {
          width: 100%;
          text-align: center;
        }
      }
    </style>
  </head>

  <body>
    <!-- Skip to content -->
    <a href="#main-content" class="sr-only" style="position:absolute;">Skip to main content</a>

    <!-- ===== NAV BAR ===== -->
    <header id="navbar" style="
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      transition: background 0.3s, backdrop-filter 0.3s;
    ">
      <a href="/bull-ride-march28/" style="display:flex;align-items:center;">
        <img
          src="/images/optimized/elote-king-logo-transparent.webp"
          alt="Elote King Atlanta"
          width="80"
          height="80"
          style="width:80px;height:80px;object-fit:contain;"
          id="nav-logo"
        />
      </a>

      <!-- Compact countdown in navbar -->
      <div id="nav-countdown" style="
        display: flex;
        align-items: center;
        gap: 2px;
        font-family: var(--font-heading);
        font-size: 20px;
        letter-spacing: 1px;
        color: var(--orange);
        background: rgba(10,10,10,0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 6px 14px;
        border-radius: 100px;
      ">
        <span id="nav-cd-d">--</span><span style="color:var(--text-muted);font-size:14px;">d</span>
        <span style="color:var(--text-muted);margin:0 2px;">:</span>
        <span id="nav-cd-h">--</span><span style="color:var(--text-muted);font-size:14px;">h</span>
        <span style="color:var(--text-muted);margin:0 2px;">:</span>
        <span id="nav-cd-m">--</span><span style="color:var(--text-muted);font-size:14px;">m</span>
        <span style="color:var(--text-muted);margin:0 2px;">:</span>
        <span id="nav-cd-s">--</span><span style="color:var(--text-muted);font-size:14px;">s</span>
      </div>

      <!-- Desktop nav -->
      <nav id="desktop-nav" style="display:flex;align-items:center;gap:32px;">
        <a href="#challenge" style="font-family:var(--font-body);font-size:14px;font-weight:600;letter-spacing:0.5px;color:var(--text-body);transition:color 0.15s;">The Challenge</a>
        <a href="#menu" style="font-family:var(--font-body);font-size:14px;font-weight:600;letter-spacing:0.5px;color:var(--text-body);transition:color 0.15s;">Menu</a>
        <a href="#faq" style="font-family:var(--font-body);font-size:14px;font-weight:600;letter-spacing:0.5px;color:var(--text-body);transition:color 0.15s;">FAQ</a>
        <a href="#closer" class="btn-primary" style="padding:10px 24px;font-size:14px;">I'M IN</a>
      </nav>

      <!-- Mobile hamburger -->
      <button id="hamburger" aria-label="Open menu" style="
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      ">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FAFAFA" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </header>

    <!-- Mobile drawer -->
    <div id="mobile-drawer" style="
      display: none;
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(10,10,10,0.97);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 32px;
    ">
      <button id="drawer-close" aria-label="Close menu" style="
        position: absolute;
        top: 20px;
        right: 24px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      ">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#FAFAFA" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
      <a href="#challenge" class="drawer-link" style="font-family:var(--font-heading);font-size:36px;letter-spacing:1.5px;color:var(--text-primary);">The Challenge</a>
      <a href="#menu" class="drawer-link" style="font-family:var(--font-heading);font-size:36px;letter-spacing:1.5px;color:var(--text-primary);">Menu</a>
      <a href="#faq" class="drawer-link" style="font-family:var(--font-heading);font-size:36px;letter-spacing:1.5px;color:var(--text-primary);">FAQ</a>
      <a href="#closer" class="btn-primary" style="margin-top:16px;width:240px;">I'M IN</a>
    </div>

    <main id="main-content">

      <!-- ========================================= -->
      <!-- SECTION 1 — HERO                          -->
      <!-- ========================================= -->
      <section id="hero" style="
        position: relative;
        width: 100%;
        height: 100dvh;
        min-height: 600px;
        overflow: hidden;
        background: var(--page-bg);
      ">
        <!-- Video background — inline src for fastest autoplay, JS swaps on desktop -->
        <video
          id="hero-video"
          src="/video/eloteking-hero-mobile.mp4"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          disablepictureinpicture
          disableremoteplayback
          x-webkit-airplay="deny"
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;z-index:0;"
        ></video>
        <script>
          (function(){
            var v = document.getElementById('hero-video');
            if (v && window.innerWidth > 768) {
              v.src = '/video/eloteking-hero-v9-enhanced.mp4';
            }
            if (v) { v.muted = true; v.play().catch(function(){}); }
          })();
        </script>

        <!-- Gradient overlay -->
        <div style="
          position: absolute;
          inset: 0;
          z-index: 1;
          background: linear-gradient(to bottom, transparent 0%, rgba(10,10,10,0.35) 40%, rgba(10,10,10,0.82) 80%, #0A0A0A 100%);
        "></div>

        <!-- Text cluster — pinned to very bottom for max video visibility -->
        <div id="hero-text" style="
          position: absolute;
          bottom: 24px;
          left: 24px;
          right: 24px;
          z-index: 2;
          max-width: 640px;
        ">
          <!-- Date pill -->
          <div class="fade-in hero-date-pill" style="
            display: inline-block;
            background: rgba(250,250,250,0.12);
            backdrop-filter: blur(8px);
            padding: 8px 20px;
            border-radius: 100px;
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            color: var(--text-primary);
            margin-bottom: 20px;
            animation-delay: 0.3s;
          ">
            SATURDAY, MARCH 28 · 7PM–11PM · FREE ENTRY
          </div>

          <!-- H1 -->
          <h1 class="fade-up" style="
            font-size: 80px;
            line-height: 0.95;
            letter-spacing: 1.5px;
            margin-bottom: 16px;
            animation-delay: 0.5s;
          ">
            One Bull. One Night.<br/>Show Up or Regret It.
          </h1>

          <!-- FOMO bar + CTAs removed from hero — max video visibility -->
        </div>
      </section>


      <!-- ========================================= -->
      <!-- SECTION 2 — FOMO TICKER                   -->
      <!-- ========================================= -->
      <section id="ticker" style="
        width: 100%;
        height: 96px;
        background: var(--orange);
        overflow: hidden;
        display: flex;
        align-items: center;
      ">
        <div class="ticker-inner" style="
          display: flex;
          width: max-content;
          animation: ticker 28s linear infinite;
        ">
          <!-- Two copies for seamless loop -->
          <span class="ticker-text">FIRST 30 RIDE FREE TONIGHT&nbsp;&#9670;&nbsp;THEN $5 PER RIDE&nbsp;&#9670;&nbsp;DOORS OPEN IN <span id="ticker-cd" class="ticker-cd">3d 02h</span>&nbsp;&#9670;&nbsp;LAST EVENT PACKED THE LOT&nbsp;&#9670;&nbsp;FREE ENTRY&nbsp;&#9670;&nbsp;100% ZABIHA HALAL&nbsp;&#9670;&nbsp;WHO'S RIDING?&nbsp;&#9670;&nbsp;</span>
          <span class="ticker-text">FIRST 30 RIDE FREE TONIGHT&nbsp;&#9670;&nbsp;THEN $5 PER RIDE&nbsp;&#9670;&nbsp;DOORS OPEN IN <span id="ticker-cd-2" class="ticker-cd">3d 02h</span>&nbsp;&#9670;&nbsp;LAST EVENT PACKED THE LOT&nbsp;&#9670;&nbsp;FREE ENTRY&nbsp;&#9670;&nbsp;100% ZABIHA HALAL&nbsp;&#9670;&nbsp;WHO'S RIDING?&nbsp;&#9670;&nbsp;</span>
        </div>
      </section>




      <!-- ========================================= -->
      <!-- SECTION 3 — THE CHALLENGE                 -->
      <!-- ========================================= -->
      <section id="challenge" style="background:var(--page-bg);" class="section-padding">
        <div class="section-inner">

          <!-- Part A: Two-Column Block -->
          <div class="challenge-grid">
            <!-- Left: Copy -->
            <div>
              <h2 class="fade-up" style="
                font-size: 56px;
                line-height: 1.0;
                letter-spacing: 1px;
                margin-bottom: 16px;
              ">The Bull Decides Who Eats Free.</h2>

              <p class="fade-up" style="
                font-size: 18px;
                line-height: 1.65;
                color: var(--text-body);
                margin-bottom: 16px;
                max-width: 520px;
              ">First 30 ride free. After that, $5. Hold on long enough and the bull feeds you.</p>

              <!-- FOMO bar — synced with getRiderSpots() -->
              <div class="fade-up" style="display:flex;flex-direction:column;align-items:flex-start;gap:6px;margin-top:20px;max-width:400px;">
                <div style="display:flex;align-items:center;gap:8px;font-size:15px;color:var(--text-muted);">
                  <span style="width:8px;height:8px;border-radius:50%;background:var(--orange);display:inline-block;animation:pulse-dot 1.5s ease-in-out infinite;"></span>
                  <span id="challenge-left" style="font-family:var(--font-heading);font-size:20px;color:var(--orange);letter-spacing:0.5px;">3 FREE RIDES LEFT TONIGHT</span>
                </div>
                <div class="fomo-bar" style="margin:0;">
                  <div id="challenge-progress-bar" class="fomo-bar-fill" style="width:90%;"></div>
                </div>
                <span style="font-size:13px;color:var(--text-muted);">First 30 ride free · $5 after</span>
              </div>

              <a href="#closer" class="btn-primary fade-up" style="margin-top:24px;">CLAIM MY FREE RIDE</a>
            </div>

            <!-- Right: Photo grid -->
            <div class="fade-up photo-collage" style="animation-delay:0.1s;">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <img src="/images/bull-ride/crowd-bull-rider-waving.webp" alt="Bull rider waving to the crowd" style="border-radius:12px;width:100%;height:200px;object-fit:cover;" loading="lazy" />
                <img src="/images/bull-ride/crowd-01-squad-clean.webp" alt="Squad enjoying bull ride night" style="border-radius:12px;width:100%;height:200px;object-fit:cover;" loading="lazy" />
                <img src="/images/bull-ride/food-birria-taco.webp" alt="Birria tacos being served" style="border-radius:12px;width:100%;height:200px;object-fit:cover;" loading="lazy" />
                <img src="/images/bull-ride/crowd-crowd-families.webp" alt="Families at the event" style="border-radius:12px;width:100%;height:200px;object-fit:cover;" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- Part B: Tier Cards -->
          <div class="tier-cards fade-up" style="
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 24px;
            margin-top: 64px;
          ">
            <!-- Consolation: 8 Seconds -->
            <div class="card" style="padding:32px;text-align:center;position:relative;">
              <span style="font-family:var(--font-body);font-size:13px;font-weight:600;letter-spacing:1px;color:var(--text-muted);text-transform:uppercase;">Consolation</span>
              <div style="font-family:var(--font-heading);font-size:48px;letter-spacing:0;margin:12px 0 8px;color:var(--text-primary);">8 SEC</div>
              <div style="width:100%;height:1px;background:var(--border-subtle);margin:8px 0 16px;"></div>
              <div style="font-family:var(--font-heading);font-size:28px;letter-spacing:0.5px;color:var(--text-primary);">FREE DRINK UPGRADE</div>
              <p style="font-size:14px;color:var(--text-muted);margin-top:8px;">Hold 8 seconds. Walk away with something.</p>
            </div>

            <!-- Tier 1: 12 Seconds -->
