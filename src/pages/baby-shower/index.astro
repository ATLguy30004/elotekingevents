<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mariana's Baby Shower — Elote King Atlanta Catering Proposal</title>
    <meta name="description" content="Personalized catering proposal for Mariana's baby shower. 60 guests. Esquite + Churros from $8.99/person. Elote King Atlanta.">
    <meta property="og:title" content="Mariana's Baby Shower — Elote King Catering">
    <meta property="og:description" content="Personalized catering proposal. 60 guests. From $8.99/person. Elote King Atlanta.">
    <meta property="og:image" content="/catering/hero-food.webp">
    <meta property="og:type" content="website">
    <link rel="canonical" href="https://events.elotekingatlanta.com/baby-shower/">
