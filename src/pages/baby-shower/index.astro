    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <style>
        @import "@/styles/starwind.css";

        /* Manus custom colors as Tailwind v4 theme extensions */
        @theme {
            --color-elote-green: #16a34a;
            --color-elote-green-dark: #15803d;
            --color-elote-yellow: #FFD700;
            --color-elote-yellow-light: #FFF8DC;
            --color-elote-orange: #FF8C00;
            --color-elote-dark: #2D2D2D;
        }

        /* Manus fonts */
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap');

        body { font-family: 'Poppins', sans-serif; }
        .font-script { font-family: 'Poppins', sans-serif; font-weight: 800; letter-spacing: -0.02em; }

        /* Manus design patterns */
        .hero-gradient { background: linear-gradient(135deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.3) 100%); }
        .btn-primary { background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); transition: all 0.3s ease; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(22, 163, 74, 0.3); }
        .btn-secondary { background: linear-gradient(135deg, #FFD700 0%, #FFC107 100%); transition: all 0.3s ease; }
        .btn-secondary:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(255, 215, 0, 0.3); }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .sticky-cta { animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.02); } }
        .faq-content { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
        .faq-item.active .faq-content { max-height: 500px; }
        .faq-item.active .faq-icon { transform: rotate(180deg); }
        .faq-icon { transition: transform 0.3s ease; }
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { overflow-x: hidden; }
        * { max-width: 100vw; box-sizing: border-box; }
    </style>
</head>
